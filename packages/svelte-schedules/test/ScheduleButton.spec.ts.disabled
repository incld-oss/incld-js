import { test, expect } from '@playwright/experimental-ct-svelte';
import ScheduleButton from '../src/ScheduleButton.svelte';

test('ScheduleButton renders', async ({ mount, page }) => {
  await mount(ScheduleButton, {
    props: {
      scheduleId: '123',
      action: 'run'
    }
  });
  await expect(page.getByRole('button', { name: 'Schedule', exact: true })).toBeVisible();
});
