import { test, expect } from '@playwright/experimental-ct-react';
import { ApprovalButton } from '../src/components/ApprovalButton';
import { IncldClientProvider } from '../src/provider';

test('ApprovalButton renders', async ({ mount, page }) => {
  page.on('console', msg => console.log('BROWSER CONSOLE:', msg.text()));
  page.on('pageerror', err => console.error('BROWSER ERROR:', err));
  await mount(
    <IncldClientProvider apiKey="test-key">
      <ApprovalButton
        approvalId="123"
        action="run"
      />
    </IncldClientProvider>
  );
  console.log('PAGE CONTENT:', await page.content());
  await expect(page.getByRole('button', { name: 'Approval', exact: true })).toBeVisible();
});
