{
  "name": "@incld/react-schedules",
  "version": "0.2.1",
  "description": "@incld React components for durable user-controlled scheduling",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/default.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@incld/client": "0.2.1",
    "@incld/react": "0.2.1"
  },
  "devDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "files": ["dist"],
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/incld-oss/incld-js.git", "directory": "packages/react-schedules"},
  "homepage": "https://incld.dev/docs",
  "bugs": {"url": "https://github.com/incld-oss/incld-js/issues"},
  "publishConfig": {"access": "public", "provenance": true}
